<Window
    x:Class="Sidrena.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Sidrena Desktop">

    <Grid Background="{StaticResource SidrenaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SidrenaAccentSoftBrush}" BorderBrush="{StaticResource SidrenaStrokeBrush}" BorderThickness="1">
                    <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource SidrenaAccentBrush}" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Sidrena Desktop" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="WinUI 3 premium workspace" FontSize="11" Foreground="{StaticResource SidrenaMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border CornerRadius="14" Padding="12,5" Background="{StaticResource SidrenaAccentSoftBrush}">
                    <TextBlock Text="Local-first · no telemetry" Foreground="{StaticResource SidrenaAccentBrush}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <Border CornerRadius="14" Padding="12,5" Background="{StaticResource SidrenaPanelAltBrush}" BorderBrush="{StaticResource SidrenaStrokeBrush}" BorderThickness="1">
                    <TextBlock Text="Development line" Foreground="{StaticResource SidrenaMutedBrush}" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <muxc:NavigationView x:Name="RootNavigation"
                             Grid.Row="1"
                             PaneDisplayMode="Left"
                             PaneTitle="Sidrena"
                             Header="Dashboard"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             OpenPaneLength="252"
                             CompactPaneLength="64"
                             Background="Transparent"
                             SelectionChanged="OnNavigationSelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" IsSelected="True" />
                <muxc:NavigationViewItem Content="Katalog" Tag="catalog" Icon="List" />
                <muxc:NavigationViewItem Content="Import / Export" Tag="importExport" Icon="Import" />
                <muxc:NavigationViewItem Content="Legal readiness" Tag="legal" Icon="Shield" />
                <muxc:NavigationViewItem Content="WordPress sync" Tag="sync" Icon="Sync" />
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Window>
