<Window
    x:Class="Sidrena.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Sidrena Desktop">

    <Grid Background="{StaticResource SidrenaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="20,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="12" Background="{StaticResource SidrenaPanelAltBrush}">
                    <Image Width="22" Height="22" Source="Assets/sidrena-mark.svg" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Sidrena Desktop" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Premium Windows app za sidrene cijene" FontSize="11" Foreground="{StaticResource SidrenaMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="16" Padding="12,6" Background="#183526">
                <TextBlock Text="Legal readiness · 0.6.x" Foreground="{StaticResource SidrenaAccentBrush}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <muxc:NavigationView Grid.Row="1"
                             PaneDisplayMode="Left"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             OpenPaneLength="250"
                             CompactPaneLength="64"
                             Background="Transparent">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Dashboard" Icon="Home" IsSelected="True" />
                <muxc:NavigationViewItem Content="Katalog" Icon="Shop" />
                <muxc:NavigationViewItem Content="Import / Export" Icon="Import" />
                <muxc:NavigationViewItem Content="Objava" Icon="Upload" />
                <muxc:NavigationViewItem Content="Audit" Icon="ReportHacked" />
            </muxc:NavigationView.MenuItems>

            <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sidrene cijene bez ručnog kaosa" FontSize="34" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Uvoz, provjera, priprema javnog CSV/XML/HTML cjenika i buduća objava prema Sidrena pluginu." FontSize="15" Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" MaxWidth="760" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                            <Button Content="Provjeri katalog" Click="OnValidateClick" />
                            <Button Content="Lokalni export" Click="OnExportClick" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="22" Padding="18" Background="{StaticResource SidrenaPanelBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Proizvodi" Foreground="{StaticResource SidrenaMutedBrush}" />
                                <TextBlock x:Name="ProductCountText" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="22" Padding="18" Background="{StaticResource SidrenaPanelBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Spremno" Foreground="{StaticResource SidrenaMutedBrush}" />
                                <TextBlock x:Name="ReadyCountText" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SidrenaAccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="22" Padding="18" Background="{StaticResource SidrenaPanelBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Upozorenja" Foreground="{StaticResource SidrenaMutedBrush}" />
                                <TextBlock x:Name="IssueCountText" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SidrenaWarningBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" CornerRadius="22" Padding="18" Background="{StaticResource SidrenaPanelBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Zadnji export" Foreground="{StaticResource SidrenaMutedBrush}" />
                                <TextBlock x:Name="LastExportText" Text="nije izrađen" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="28" Padding="22" Background="{StaticResource SidrenaPanelBrush}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Legal readiness" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Tehnička provjera obaveznih polja, referentnih datuma, jedinica mjere i lokacija. Ovo nije pravna garancija, nego kontrolna lista prije objave." Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" />
                                <ListView x:Name="IssueList" MinHeight="220" SelectionMode="None" Background="Transparent" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="28" Padding="22" Background="{StaticResource SidrenaPanelAltBrush}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Objava i sinkronizacija" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Prva verzija radi lokalni export. Sljedeća faza dodaje sigurnu REST sinkronizaciju prema Sidrena WordPress/WooCommerce pluginu." Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" />
                                <InfoBar Title="Referentni datumi" Message="10.09.2026. za novobuhvaćene proizvode/usluge i 02.05.2025. za prethodno obuhvaćene FMCG kategorije." Severity="Informational" IsOpen="True" />
                                <InfoBar Title="Privatnost" Message="Aplikacija ne šalje katalog Brendigu. Export je lokalni dok korisnik ne uključi sinkronizaciju." Severity="Success" IsOpen="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </muxc:NavigationView>
    </Grid>
</Window>
