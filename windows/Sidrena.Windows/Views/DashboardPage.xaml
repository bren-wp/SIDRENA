<Page
    x:Class="Sidrena.Windows.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="22">
            <Border CornerRadius="30" Padding="28" Background="{StaticResource SidrenaPanelAltBrush}" BorderBrush="{StaticResource SidrenaStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sidrena Windows workspace" FontSize="36" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Premium WinUI 3 dashboard za katalog, tehničku provjeru, lokalni export i pripremu WordPress/WooCommerce sinkronizacije." FontSize="15" Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" MaxWidth="820" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                        <Button Content="Provjeri katalog" Click="OnValidateClick" />
                        <Button Content="Lokalni export" Click="OnExportClick" />
                        <Button Content="Učitaj demo" Click="OnLoadDemoClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="8"><TextBlock Text="Status kataloga" Foreground="{StaticResource SidrenaMutedBrush}" /><TextBlock x:Name="CatalogStatusText" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="8"><TextBlock Text="Stavke" Foreground="{StaticResource SidrenaMutedBrush}" /><TextBlock x:Name="ProductCountText" FontSize="30" FontWeight="SemiBold" Foreground="White" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="8"><TextBlock Text="Spremno" Foreground="{StaticResource SidrenaMutedBrush}" /><TextBlock x:Name="ReadyCountText" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource SidrenaAccentBrush}" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="8"><TextBlock Text="Greške" Foreground="{StaticResource SidrenaMutedBrush}" /><TextBlock x:Name="IssueCountText" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource SidrenaWarningBrush}" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="8"><TextBlock Text="Zadnja objava" Foreground="{StaticResource SidrenaMutedBrush}" /><TextBlock x:Name="LastPublicationText" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="5" Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="8"><TextBlock Text="Sync" Foreground="{StaticResource SidrenaMutedBrush}" /><TextBlock x:Name="SyncStatusText" FontSize="16" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Legal readiness status" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="LegalStatusText" Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" />
                        <ListView x:Name="IssueList" MinHeight="220" SelectionMode="None" Background="Transparent" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SidrenaSubtleCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Objava i export" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Prva Windows linija radi lokalnu pripremu i export. REST sync ostaje ručno uključen i ne šalje podatke bez korisničke konfiguracije." Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" />
                        <muxc:InfoBar Title="Referentni datumi" Message="10.09.2026. za novobuhvaćene proizvode/usluge i 02.05.2025. za ranije obuhvaćene FMCG kategorije." Severity="Informational" IsOpen="True" />
                        <muxc:InfoBar Title="Privatnost" Message="Katalog ostaje lokalno na računalu dok korisnik ručno ne konfigurira WordPress vezu." Severity="Success" IsOpen="True" />
                        <TextBlock x:Name="ActionStatusText" Foreground="{StaticResource SidrenaAccentBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
