<Page
    x:Class="Sidrena.Windows.Views.ImportExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer Padding="28">
        <StackPanel Spacing="18">
            <Border Style="{StaticResource SidrenaSubtleCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Import / Export" FontSize="28" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="CSV i XML su pripremljeni kao funkcionalni lokalni workflow. XLSX je označen kao planiran dok ne postoji stvarni parser." Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Import" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Prva verzija koristi provjerljive demo import tokove bez slanja podataka izvan računala." Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" />
                        <Button Content="Import CSV preview" Click="OnCsvImportClick" />
                        <Button Content="Import XML preview" Click="OnXmlImportClick" />
                        <Button Content="XLSX plan" Click="OnXlsxPlanClick" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SidrenaCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Export" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Export kreira paket za Sidrena WordPress/WooCommerce plugin i javnu objavu cjenika." Foreground="{StaticResource SidrenaMutedBrush}" TextWrapping="Wrap" />
                        <Button Content="Export CSV/XML/HTML paket" Click="OnExportClick" />
                        <muxc:InfoBar Title="Lokalni export" Message="Datoteke se spremaju u korisnički LocalAppData direktorij." Severity="Informational" IsOpen="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SidrenaCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Rezultat" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="ResultText" Foreground="{StaticResource SidrenaAccentBrush}" TextWrapping="Wrap" />
                    <ListView x:Name="FileList" MinHeight="120" SelectionMode="None" Background="Transparent" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
