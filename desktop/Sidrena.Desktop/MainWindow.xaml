<Window x:Class="Sidrena.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIDRENA — Upravljanje cijenama"
        Width="1220" Height="780" MinWidth="900" MinHeight="670"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#11182B" BorderBrush="#26344B" BorderThickness="0,0,1,0">
            <DockPanel Margin="22,24">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="◆ SIDRENA" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="DESKTOP • LOCAL FIRST" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,35"/>
                    <Border Background="#252F45" CornerRadius="7" Padding="14,13" Margin="0,0,0,8">
                        <TextBlock Text="▦  Artikli i usluge" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="7" Padding="14,13" Margin="0,0,0,8">
                        <TextBlock Text="▤  Povijest cijena" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                    <Border CornerRadius="7" Padding="14,13" Margin="0,0,0,8">
                        <TextBlock Text="⇩  Radni izvoz" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="Privatni podaci ostaju na računalu." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock Text="SIDRENA Desktop 0.1" Foreground="#6D7993" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,22,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Katalog i sidrene cijene" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Lokalno upravljanje stavkama i vjerodostojnom poviješću cijena" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#263445" CornerRadius="7" Padding="12,8" HorizontalAlignment="Right">
                    <TextBlock Text="●  Lokalna baza" Foreground="#83D6B5" FontSize="12"/>
                </Border>
            </DockPanel>
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Nova stavka" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,11"/>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Naziv"/>
                        <TextBox x:Name="NameBox" ToolTip="Obvezno polje" AutomationProperties.Name="Naziv proizvoda ili usluge"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Text="Vrsta"/>
                        <ComboBox x:Name="KindCombo" SelectedIndex="0" AutomationProperties.Name="Vrsta stavke">
                            <ComboBoxItem Content="Proizvod"/>
                            <ComboBoxItem Content="Usluga"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Šifra"/>
                        <TextBox x:Name="SkuBox" AutomationProperties.Name="Šifra proizvoda"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3">
                        <TextBlock Text="Barkod"/>
                        <TextBox x:Name="BarcodeBox" AutomationProperties.Name="Barkod proizvoda"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Text="Aktualna cijena (EUR)"/>
                        <TextBox x:Name="CurrentPriceBox" ToolTip="Primjer: 10,50" AutomationProperties.Name="Aktualna cijena u eurima"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Text="Sidrena cijena (EUR)"/>
                        <TextBox x:Name="AnchorPriceBox" ToolTip="Ostavite prazno ako povijesna cijena nije potvrđena." AutomationProperties.Name="Potvrđena povijesna sidrena cijena"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Referentni datum"/>
                        <ComboBox x:Name="AnchorDateCombo" SelectedIndex="0" AutomationProperties.Name="Datum sidrene cijene">
                            <ComboBoxItem Content="10. 9. 2026." Tag="2026-09-10"/>
                            <ComboBoxItem Content="2. 5. 2025." Tag="2025-05-02"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="3">
                        <TextBlock Text="Jedinica mjere"/>
                        <TextBox x:Name="UnitBox" Text="kom" AutomationProperties.Name="Jedinica mjere"/>
                    </StackPanel>
                    <DockPanel Grid.Row="3" Grid.ColumnSpan="4">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Dodaj stavku" Background="{StaticResource AccentBrush}" Foreground="#101827"
                                    Click="OnAddItem" AutomationProperties.Name="Dodaj stavku u katalog"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Izvor sidrene cijene (obvezan ako je unesen iznos)"/>
                            <TextBox x:Name="AnchorSourceBox" MinWidth="360"
                                     AutomationProperties.Name="Izvor povijesne sidrene cijene"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="CountLabel" Text="Artikli i usluge" FontSize="17" FontWeight="SemiBold"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Izvezi radni CSV" Click="OnExportCsv"/>
                            <Button Content="Izvezi radni XML" Click="OnExportXml"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" RowHeight="37"
                              Foreground="#172033" Background="#F6F8FC"
                              AlternatingRowBackground="#ECF0F7" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Vrsta" Binding="{Binding Kind}" Width="90"/>
                            <DataGridTextColumn Header="Šifra" Binding="{Binding Sku}" Width="105"/>
                            <DataGridTextColumn Header="Aktualna EUR" Binding="{Binding Current}" Width="120"/>
                            <DataGridTextColumn Header="Sidrena EUR" Binding="{Binding Anchor}" Width="120"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding AnchorDate}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Promijeni cijenu odabrane stavke" Click="OnUpdatePrice"
                                Background="#334667" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="NewPriceBox" Width="132" ToolTip="Nova cijena u EUR" AutomationProperties.Name="Nova aktualna cijena"/>
                            <TextBox x:Name="ReasonBox" Width="230" ToolTip="Obvezan razlog promjene" AutomationProperties.Name="Razlog izmjene cijene"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" x:Name="StatusLabel" Margin="0,12,0,0"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="Radni izvozi nisu službeno validirani javni cjenici."/>
        </Grid>
    </Grid>
</Window>
