<Window x:Class="Sidrena.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIDRENA — Sidrene cijene i digitalni cjenici"
        Width="1550" Height="910" MinWidth="1000" MinHeight="670"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}" KeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel Margin="18,24,18,22">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,27">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="62" Height="62">
                            <Canvas Width="128" Height="128">
                                <Ellipse Canvas.Left="57" Canvas.Top="3" Width="14" Height="14" Fill="{StaticResource AccentBrush}"/>
                                <Path Fill="{StaticResource AccentBrush}" Data="M60 19 H68 V91 H60 Z M52 38 H77 V46 H52 Z M12 78 L32 88 L42 71 L50 77 L37 99 Q51 114 64 113 Q82 112 93 99 L81 77 L89 71 L99 88 L119 78 L116 107 L103 97 Q87 123 64 124 Q40 123 25 97 L12 107 Z"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel Margin="12,12,0,0">
                            <TextBlock Text="SIDRENA" FontWeight="Bold" FontSize="24"/>
                            <TextBlock Text="Sidrene cijene i digitalni cjenici" FontSize="9.5"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#10233A" CornerRadius="9"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12" Margin="4,16,4,0">
                    <StackPanel>
                        <TextBlock Text="●  Lokalni podaci" Foreground="#53D0A0" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Vaši podaci ostaju na ovom računalu." FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock x:Name="EditionLabel" Text="SIDRENA Desktop 0.2 · razvojna verzija"
                                   FontSize="10" Foreground="#90A5C0" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel">
                        <Button Tag="Pregled" Content="⌂    Pregled" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Artikli" Content="⬡    Artikli" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Usluge" Content="⚒    Usluge" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Povijest cijena" Content="◴    Povijest cijena" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Cjenici" Content="▤    Cjenici" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Lokacije" Content="⌖    Lokacije" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Sinkronizacija" Content="↥    Sinkronizacija" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Arhiva" Content="▣    Arhiva" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Separator Background="{StaticResource BorderBrush}" Margin="8,15"/>
                        <Button Tag="Postavke" Content="⚙    Postavke" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                        <Button Tag="Pomoć" Content="?    Pomoć" Click="OnNavigate" Style="{StaticResource NavButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="19,17,19,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="12" Height="146" ClipToBounds="True"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#0D2543" Offset="0"/>
                        <GradientStop Color="#183554" Offset=".53"/>
                        <GradientStop Color="#9A5639" Offset=".82"/>
                        <GradientStop Color="#F18D49" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel Margin="24,17">
                    <Border DockPanel.Dock="Right" Background="#BD0C1D33" CornerRadius="9"
                            Padding="15,10" VerticalAlignment="Center" MaxWidth="255">
                        <StackPanel>
                            <TextBlock Text="⚓  SIDRENA" FontSize="17" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Text="Lokalni katalog i radni cjenici" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="Propisi: provjera prije javne objave" Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="POUZDANE CIJENE. JEDNOSTAVNIJI RAD." FontSize="11"
                                   Foreground="#CBD8E8"/>
                        <TextBlock x:Name="PageTitle" Text="Pregled" FontSize="34" FontWeight="Bold" Margin="0,7,0,2"/>
                        <TextBlock x:Name="PageSubtitle" Text="Upravljajte svojim cijenama." FontSize="14"
                                   Foreground="#D8E2F1" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto" Background="Transparent">
                <ContentControl x:Name="PageHost"/>
            </ScrollViewer>
            <Border Grid.Row="2" Padding="9,8" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                <DockPanel>
                    <TextBlock x:Name="StatusLabel" Text="Lokalna baza spremna. Radni izvozi nisu javno validirani cjenici."
                               FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
